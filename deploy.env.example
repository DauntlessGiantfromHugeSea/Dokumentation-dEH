# Kopieren nach deploy.env (ist gitignored) und Werte setzen.

# Flask-Sitzungsschlüssel — einmalig generieren: openssl rand -hex 32
SECRET_KEY=CHANGE-ME

# --- frodor-Anbindung (Camp-Anmeldungen) ---
# Service-Account mit Rolle "Sanitätsdokumentation" (siehe
# frodor-supabase/scripts/setup_sanitaetsdokumentation.sql).
# Alle FRODOR_* weglassen = Anbindung deaktiviert.
FRODOR_SUPABASE_URL=https://CHANGE-ME.supabase.co
FRODOR_SUPABASE_ANON_KEY=CHANGE-ME
FRODOR_EMAIL=sanidoku@CHANGE-ME.de
FRODOR_PASSWORD=CHANGE-ME
FRODOR_EVENT_SLUG=dc-ost-2026

# --- Backups (scripts/backup.sh) ---
# age-Empfänger (public key). Schlüsselpaar auf dem EIGENEN Laptop erzeugen:
#   age-keygen -o camp-doku-backup-key.txt      (Datei sicher verwahren!)
# Den "public key: age1..." hier eintragen — der Server kann damit
# verschlüsseln, aber alte Backups NICHT entschlüsseln.
BACKUP_AGE_RECIPIENT=age1CHANGE-ME
# Aufbewahrung in Tagen
BACKUP_KEEP_DAYS=14
# Optional: Off-Site-Ziel für rsync (z. B. user@backup-host:/backups/camp-doku)
#BACKUP_RSYNC_TARGET=
